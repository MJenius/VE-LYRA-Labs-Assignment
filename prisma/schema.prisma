generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MenuItem {
  id                   String          @id @default(uuid())
  name                 String
  category             String
  price                Decimal         @db.Decimal(10, 2)
  description          String
  imageUrl             String          @map("image_url")
  tags                 String[]
  allergens            String[]
  available            Boolean         @default(true)
  popularScore         Float           @default(0) @map("popular_score")
  calories             Int
  prepTimeMinutes      Int             @map("prep_time_minutes")
  taxRate              Decimal         @db.Decimal(4, 2) @map("tax_rate")
  embedding            MenuEmbedding?
  orderItems           OrderItem[]
  createdAt            DateTime        @default(now()) @map("created_at")

  @@map("menu_items")
}

model MenuEmbedding {
  menuItemId     String   @id @map("menu_item_id")
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  embeddingModel String   @map("embedding_model")
  embedding      Unsupported("vector(1536)")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("menu_embeddings")
}

model TableSession {
  id                  String      @id @default(uuid())
  tableId             String      @map("table_id")
  status              String      @default("active")
  preferences         Json        @default("{}")
  conversationSummary String      @default("") @map("conversation_summary")
  createdAt           DateTime    @default(now()) @map("created_at")
  expiresAt           DateTime    @map("expires_at")
  cartItems           CartItem[]
  messages            Message[]
  order               Order?

  @@index([tableId, status])
  @@map("sessions")
}

model CartItem {
  id                  String       @id @default(uuid())
  sessionId           String       @map("session_id")
  session             TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  menuItemId          String       @map("menu_item_id")
  quantity            Int          @default(1)
  specialInstructions String?      @map("special_instructions")
  addedBy             String       @map("added_by")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  @@index([sessionId])
  @@map("cart_items")
}

model Message {
  id        String       @id @default(uuid())
  sessionId String       @map("session_id")
  session   TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  agentName String?      @map("agent_name")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("messages")
}

model Order {
  id                String       @id @default(uuid())
  sessionId         String       @unique @map("session_id")
  session           TableSession @relation(fields: [sessionId], references: [id])
  customerName      String       @map("customer_name")
  customerPhoneHash String       @map("customer_phone_hash")
  status            String       @default("PENDING")
  subtotal          Decimal      @db.Decimal(10, 2)
  taxAmount         Decimal      @db.Decimal(10, 2) @map("tax_amount")
  totalAmount       Decimal      @db.Decimal(10, 2) @map("total_amount")
  estimatedWait     Int          @map("estimated_wait")
  items             OrderItem[]
  createdAt         DateTime     @default(now()) @map("created_at")

  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String   @map("order_id")
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId          String   @map("menu_item_id")
  menuItem            MenuItem @relation(fields: [menuItemId], references: [id])
  name                String
  quantity            Int
  price               Decimal  @db.Decimal(10, 2)
  specialInstructions String?  @map("special_instructions")

  @@map("order_items")
}
